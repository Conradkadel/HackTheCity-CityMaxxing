# Copy to backend/.env (or code/.env) and adjust. Read by services.py via python-dotenv.

# Postgres with the team tables (tb_gps_filtrado, tb_bunching_events, gtfs_*, ...)
# docker-compose.yml in this folder starts a local one with these values
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bunching

# Model file for GET /buses/live (written by analysis/treinar_modelo_bunching.py)
MODEL_PATH=modelo_bunching.pkl

# Allowed frontend origins, comma separated (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Max length of one GET /replay window
MAX_REPLAY_MINUTES=30
