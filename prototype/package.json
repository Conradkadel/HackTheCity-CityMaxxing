{
  "name": "project7-replay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint src vite.config.ts",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' package.json vite.config.ts eslint.config.js",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' package.json vite.config.ts eslint.config.js",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.9",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
